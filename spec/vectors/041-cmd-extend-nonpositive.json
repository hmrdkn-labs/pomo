{
  "name": "extend-add-ms-must-be-positive",
  "device_id": "mac",
  "steps": [
    {
      "now_ms": 1000,
      "command": {
        "type": "start",
        "kind": "focus",
        "planned_ms": 60000,
        "command_key": "k1"
      },
      "expect": "ok"
    },
    {
      "now_ms": 2000,
      "command": {
        "type": "extend",
        "add_ms": 0,
        "command_key": "k2"
      },
      "expect": "error"
    },
    {
      "now_ms": 3000,
      "command": {
        "type": "extend",
        "add_ms": -100,
        "command_key": "k3"
      },
      "expect": "error"
    },
    {
      "now_ms": 4000,
      "command": {
        "type": "extend",
        "add_ms": 1000,
        "command_key": "k4"
      },
      "expect": "ok"
    },
    {
      "now_ms": 5000,
      "command": {
        "type": "extend",
        "add_ms": 1500,
        "command_key": "k5"
      },
      "expect": "ok"
    },
    {
      "now_ms": 6000,
      "command": {
        "type": "skip",
        "command_key": "k6"
      },
      "expect": "ok"
    },
    {
      "now_ms": 7000,
      "command": {
        "type": "extend",
        "add_ms": 5000,
        "command_key": "k7"
      },
      "expect": "error"
    }
  ],
  "final_event_count": 4
}
