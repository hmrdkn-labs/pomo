{
  "name": "label-defaults-to-current-then-most-recent",
  "device_id": "mac",
  "steps": [
    {
      "now_ms": 1000,
      "command": {
        "type": "label",
        "label": "x",
        "command_key": "k1"
      },
      "expect": "error"
    },
    {
      "now_ms": 2000,
      "command": {
        "type": "start",
        "kind": "focus",
        "planned_ms": 60000,
        "command_key": "k2"
      },
      "expect": "ok"
    },
    {
      "now_ms": 3000,
      "command": {
        "type": "label",
        "label": "alpha",
        "project": "p1",
        "command_key": "k3"
      },
      "expect": "ok"
    },
    {
      "now_ms": 4000,
      "command": {
        "type": "stop",
        "command_key": "k4"
      },
      "expect": "ok"
    },
    {
      "now_ms": 5000,
      "command": {
        "type": "label",
        "label": "beta",
        "command_key": "k5"
      },
      "expect": "ok"
    }
  ],
  "final_event_count": 4
}
